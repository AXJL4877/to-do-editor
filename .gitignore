node_modules/
dist/
target/
__pycache__/
# Temporary archives created by the embedded-Python bootstrap.
/tmp*/
/pip-*/

# Native build outputs
native/build/
native/*.obj

# Local FFmpeg binaries
dependencies/ffmpeg/
# Bundled Python is fetched during packaging; binaries and wheels are not tracked.
dependencies/python/
dependencies/python-*.zip
# Licensed font files; only the README is tracked
dependencies/fonts/*
!dependencies/fonts/README.md
/cache/

# Project media under data/
data/**/media/
*.mp4

# Machine-local AI settings (paths only; keys stay in the 密匙 .env or Credential Manager)
/config/ai.json
